{
    "extends": [
        ":enableRenovate",
        ":npm",
        "security:minimumReleaseAgeNpm",
        ":semanticCommitType(deps)",
        ":semanticCommitScope(renovate)",
        ":prHourlyLimit1",
        ":label(dependencies)",
        ":automergeMinor",
        ":pinDependencies",
        ":pinDevDependencies",
        "group:monorepos",
        "group:allNonMajor"
    ],
    "timezone": "Asia/Tokyo",
    "schedule": [
        "before 9am on monday"
    ],
    "rebaseWhen": "conflicted",
    "ignorePaths": [
        "**/node_modules/**"
    ],
    "suppressNotifications": [
        "prIgnoreNotification",
        "branchAutomergeFailure",
        "lockFileErrors",
        "artifactErrors",
        "onboardingClose"
    ],
    "prConcurrentLimit": 10,
    "prCreation": "immediate"
}
